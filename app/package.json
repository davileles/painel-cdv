{
  "name": "cdv-app",
  "version": "1.0.0",
  "private": true,
  "description": "App nativo (Android/iOS) do Painel do Viajante — Clube do Viajante. Capacitor sobre o index.html do painel-cdv.",
  "scripts": {
    "montar": "node montar.mjs",
    "sync": "node montar.mjs && cap sync",
    "icones": "node icones.mjs && capacitor-assets generate --iconBackgroundColor '#262e42' --iconBackgroundColorDark '#1c2333' --splashBackgroundColor '#262e42' --splashBackgroundColorDark '#1c2333'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "chart.js": "^4.4.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "sharp": "^0.35.5"
  }
}
